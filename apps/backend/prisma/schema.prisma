generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id
  fullName     String    @map("full_name") @db.VarChar(100)
  phone        String    @unique @db.VarChar(20)
  passwordHash String    @map("password_hash") @db.Text
  role         String    @default("traveler") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sessions     Session[]
  bookings     Booking[]
  orders       Order[]
  refunds      Refund[]
  notifications Notification[]
  securityEvents SecurityEvent[]

  @@map("users")
}

model Session {
  tokenHash String   @id @map("token_hash") @db.VarChar(64)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}

model Provider {
  id        String   @id
  name      String   @db.VarChar(160)
  code      String   @unique @db.VarChar(40)
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("providers")
}

model BusTrip {
  id            String    @id
  carrier       String    @db.VarChar(160)
  carrierCode   String    @map("carrier_code") @db.VarChar(40)
  serviceTitle  String    @map("service_title") @db.VarChar(160)
  departAt      DateTime  @map("depart_at") @db.Timestamptz(6)
  departStation String    @map("depart_station") @db.VarChar(160)
  departCity    String    @map("depart_city") @db.VarChar(100)
  arrivalStation String   @map("arrival_station") @db.VarChar(160)
  arrivalCity   String    @map("arrival_city") @db.VarChar(100)
  arrivalTime   String    @map("arrival_time") @db.VarChar(8)
  duration      String    @db.VarChar(40)
  priceXof      Int       @map("price_xof")
  seatCapacity  Int       @map("seat_capacity")
  amenities     Json      @default("[]") @db.JsonB
  vehicle       String    @db.VarChar(120)
  registration  String    @db.VarChar(80)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  bookings      Booking[]

  @@index([departAt])
  @@map("bus_trips")
}

model Event {
  id          String                @id
  title       String                @db.VarChar(200)
  eventType   String                @map("event_type") @db.VarChar(30)
  description String                @default("") @db.Text
  venue       String                @db.VarChar(200)
  city        String                @db.VarChar(100)
  startsAt    DateTime              @map("starts_at") @db.Timestamptz(6)
  imageUrl    String                @default("") @map("image_url") @db.Text
  status      String                @default("published") @db.VarChar(20)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  categories  EventTicketCategory[]
  bookings    Booking[]

  @@index([startsAt])
  @@map("events")
}

model EventTicketCategory {
  id       String    @id
  eventId  String    @map("event_id")
  name     String    @db.VarChar(100)
  priceXof Int       @map("price_xof")
  capacity Int
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([eventId, name])
  @@map("event_ticket_categories")
}

model Booking {
  id                 String              @id
  userId             String              @map("user_id")
  productType        String              @map("product_type") @db.VarChar(20)
  busTripId          String?             @map("bus_trip_id")
  eventId            String?             @map("event_id")
  ticketCategoryId   String?             @map("ticket_category_id")
  seats              Int[]               @default([])
  quantity           Int
  amountXof          Int                 @map("amount_xof")
  currency           String              @default("XOF") @db.VarChar(3)
  status             String              @default("pending_payment") @db.VarChar(30)
  holdExpiresAt      DateTime            @map("hold_expires_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  user               User                @relation(fields: [userId], references: [id])
  busTrip            BusTrip?            @relation(fields: [busTripId], references: [id])
  event              Event?              @relation(fields: [eventId], references: [id])
  ticketCategory     EventTicketCategory? @relation(fields: [ticketCategoryId], references: [id])
  payment            Payment?
  order              Order?
  tickets            Ticket[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([busTripId, status, holdExpiresAt])
  @@index([ticketCategoryId, status, holdExpiresAt])
  @@map("bookings")
}

model Payment {
  id                String   @id
  bookingId         String   @unique @map("booking_id")
  provider          String   @default("geniuspay") @db.VarChar(40)
  providerReference String?  @unique @map("provider_reference") @db.VarChar(160)
  idempotencyKey    String   @unique @map("idempotency_key") @db.VarChar(120)
  checkoutUrl       String?  @map("checkout_url") @db.Text
  paymentMethod     String?  @map("payment_method") @db.VarChar(40)
  status            String   @default("pending") @db.VarChar(30)
  amountXof         Int      @map("amount_xof")
  providerResponse  Json     @default("{}") @map("provider_response") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Order {
  id        String   @id
  bookingId String   @unique @map("booking_id")
  userId    String   @map("user_id")
  amountXof Int      @map("amount_xof")
  currency  String   @default("XOF") @db.VarChar(3)
  status    String   @default("pending_payment") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  refund    Refund?

  @@index([userId, createdAt(sort: Desc)])
  @@map("orders")
}

model Refund {
  id          String   @id
  orderId     String   @unique @map("order_id")
  userId      String   @map("user_id")
  reason      String   @db.VarChar(1000)
  status      String   @default("requested") @db.VarChar(30)
  providerRef String?  @map("provider_ref") @db.VarChar(160)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@map("refunds")
}

model Ticket {
  id        String    @id
  bookingId String    @map("booking_id")
  ordinal   Int
  code      String    @unique @db.VarChar(40)
  status    String    @default("active") @db.VarChar(20)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, ordinal])
  @@index([bookingId])
  @@map("tickets")
}

model Settlement {
  id            String   @id
  providerCode  String   @map("provider_code") @db.VarChar(40)
  periodStart   DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd     DateTime @map("period_end") @db.Timestamptz(6)
  grossXof      Int      @map("gross_xof")
  commissionXof Int      @map("commission_xof")
  netXof        Int      @map("net_xof")
  status        String   @default("pending") @db.VarChar(30)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([providerCode, periodStart, periodEnd])
  @@index([providerCode, periodStart])
  @@map("settlements")
}

model Notification {
  id        String    @id
  userId    String?   @map("user_id")
  channel   String    @db.VarChar(20)
  template  String    @db.VarChar(100)
  payload   Json      @default("{}") @db.JsonB
  status    String    @default("queued") @db.VarChar(30)
  attempts  Int       @default(0)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("notifications")
}

model SecurityEvent {
  id        String   @id
  userId    String?  @map("user_id")
  eventType String   @map("event_type") @db.VarChar(80)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  metadata  Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@map("security_events")
}

model WebhookDelivery {
  deliveryId String   @id @map("delivery_id") @db.VarChar(200)
  eventType  String   @map("event_type") @db.VarChar(100)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@map("webhook_deliveries")
}
