generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id
  fullName     String    @map("full_name") @db.VarChar(100)
  phone        String    @unique @db.VarChar(20)
  passwordHash String    @map("password_hash") @db.Text
  role         String    @default("traveler") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  mfaSecret        String?   @map("mfa_secret") @db.Text
  mfaEnabledAt     DateTime? @map("mfa_enabled_at") @db.Timestamptz(6)
  mfaLastStep      BigInt?   @map("mfa_last_step")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  mfaBackupCodes   MfaBackupCode[]
  providerMemberships ProviderMember[]
  auditLogs        AuditLog[]
  sessions     Session[]
  bookings     Booking[]
  orders       Order[]
  refunds      Refund[]
  notifications Notification[]
  securityEvents SecurityEvent[]

  @@map("users")
}

model Session {
  tokenHash String   @id @map("token_hash") @db.VarChar(64)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}

model Provider {
  id        String   @id
  name      String   @db.VarChar(160)
  code      String   @unique @db.VarChar(40)
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  members   ProviderMember[]
  invites   ProviderInvite[]
  busTrips  BusTrip[]
  events    Event[]
  orderItems OrderItem[]
  commissionRules CommissionRule[]

  @@map("providers")
}

model BusTrip {
  id            String    @id
  carrier       String    @db.VarChar(160)
  carrierCode   String    @map("carrier_code") @db.VarChar(40)
  serviceTitle  String    @map("service_title") @db.VarChar(160)
  departAt      DateTime  @map("depart_at") @db.Timestamptz(6)
  departStation String    @map("depart_station") @db.VarChar(160)
  departCity    String    @map("depart_city") @db.VarChar(100)
  arrivalStation String   @map("arrival_station") @db.VarChar(160)
  arrivalCity   String    @map("arrival_city") @db.VarChar(100)
  arrivalTime   String    @map("arrival_time") @db.VarChar(8)
  duration      String    @db.VarChar(40)
  priceXof      Int       @map("price_xof")
  seatCapacity  Int       @map("seat_capacity")
  amenities     Json      @default("[]") @db.JsonB
  vehicle       String    @db.VarChar(120)
  registration  String    @db.VarChar(80)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  providerId    String    @map("provider_id")
  provider      Provider  @relation(fields: [providerId], references: [id])
  bookings      Booking[]

  @@index([departAt])
  @@index([providerId, departAt])
  @@map("bus_trips")
}

model Event {
  id          String                @id
  title       String                @db.VarChar(200)
  eventType   String                @map("event_type") @db.VarChar(30)
  description String                @default("") @db.Text
  venue       String                @db.VarChar(200)
  city        String                @db.VarChar(100)
  startsAt    DateTime              @map("starts_at") @db.Timestamptz(6)
  imageUrl    String                @default("") @map("image_url") @db.Text
  status      String                @default("published") @db.VarChar(20)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  providerId  String                @map("provider_id")
  provider    Provider              @relation(fields: [providerId], references: [id])
  categories  EventTicketCategory[]
  bookings    Booking[]

  @@index([startsAt])
  @@index([providerId, startsAt])
  @@map("events")
}

model EventTicketCategory {
  id       String    @id
  eventId  String    @map("event_id")
  name     String    @db.VarChar(100)
  priceXof Int       @map("price_xof")
  capacity Int
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([eventId, name])
  @@map("event_ticket_categories")
}

model Booking {
  id                 String              @id
  userId             String              @map("user_id")
  productType        String              @map("product_type") @db.VarChar(20)
  busTripId          String?             @map("bus_trip_id")
  eventId            String?             @map("event_id")
  ticketCategoryId   String?             @map("ticket_category_id")
  seats              Int[]               @default([])
  quantity           Int
  amountXof          Int                 @map("amount_xof")
  currency           String              @default("XOF") @db.VarChar(3)
  status             String              @default("pending_payment") @db.VarChar(30)
  holdExpiresAt      DateTime            @map("hold_expires_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  user               User                @relation(fields: [userId], references: [id])
  busTrip            BusTrip?            @relation(fields: [busTripId], references: [id])
  event              Event?              @relation(fields: [eventId], references: [id])
  ticketCategory     EventTicketCategory? @relation(fields: [ticketCategoryId], references: [id])
  payment            Payment?
  order              Order?
  tickets            Ticket[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([busTripId, status, holdExpiresAt])
  @@index([ticketCategoryId, status, holdExpiresAt])
  @@map("bookings")
}

model Payment {
  transactions      PaymentTransaction[]
  id                String   @id
  bookingId         String   @unique @map("booking_id")
  provider          String   @default("geniuspay") @db.VarChar(40)
  providerReference String?  @unique @map("provider_reference") @db.VarChar(160)
  idempotencyKey    String   @unique @map("idempotency_key") @db.VarChar(120)
  checkoutUrl       String?  @map("checkout_url") @db.Text
  paymentMethod     String?  @map("payment_method") @db.VarChar(40)
  status            String   @default("pending") @db.VarChar(30)
  amountXof         Int      @map("amount_xof")
  providerResponse  Json     @default("{}") @map("provider_response") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Order {
  id        String   @id
  bookingId String   @unique @map("booking_id")
  userId    String   @map("user_id")
  amountXof Int      @map("amount_xof")
  currency  String   @default("XOF") @db.VarChar(3)
  status    String   @default("pending_payment") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  refund    Refund?
  items     OrderItem[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("orders")
}

model Refund {
  id          String   @id
  orderId     String   @unique @map("order_id")
  userId      String   @map("user_id")
  reason      String   @db.VarChar(1000)
  status      String   @default("requested") @db.VarChar(30)
  providerRef String?  @map("provider_ref") @db.VarChar(160)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@map("refunds")
}

model Ticket {
  id        String    @id
  bookingId String    @map("booking_id")
  ordinal   Int
  code      String    @unique @db.VarChar(40)
  status    String    @default("active") @db.VarChar(20)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, ordinal])
  @@index([bookingId])
  @@map("tickets")
}

model Settlement {
  id            String   @id
  providerCode  String   @map("provider_code") @db.VarChar(40)
  periodStart   DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd     DateTime @map("period_end") @db.Timestamptz(6)
  grossXof      Int      @map("gross_xof")
  commissionXof Int      @map("commission_xof")
  netXof        Int      @map("net_xof")
  status        String   @default("pending") @db.VarChar(30)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)
  paidAt        DateTime? @map("paid_at") @db.Timestamptz(6)
  payoutReference String? @map("payout_reference") @db.VarChar(160)

  @@unique([providerCode, periodStart, periodEnd])
  @@index([providerCode, periodStart])
  @@map("settlements")
}

model Notification {
  id        String    @id
  userId    String?   @map("user_id")
  channel   String    @db.VarChar(20)
  template  String    @db.VarChar(100)
  payload   Json      @default("{}") @db.JsonB
  status    String    @default("queued") @db.VarChar(30)
  attempts  Int       @default(0)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("notifications")
}

model SecurityEvent {
  id        String   @id
  userId    String?  @map("user_id")
  eventType String   @map("event_type") @db.VarChar(80)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  metadata  Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@map("security_events")
}

model WebhookDelivery {
  deliveryId String   @id @map("delivery_id") @db.VarChar(200)
  eventType  String   @map("event_type") @db.VarChar(100)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@map("webhook_deliveries")
}

model MfaBackupCode {
  id       String    @id
  userId   String    @map("user_id")
  codeHash String    @map("code_hash") @db.VarChar(64)
  usedAt   DateTime? @map("used_at") @db.Timestamptz(6)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_backup_codes")
}

model AuditLog {
  id           String   @id
  userId       String?  @map("user_id")
  action       String   @db.VarChar(80)
  resourceType String?  @map("resource_type") @db.VarChar(50)
  resourceId   String?  @map("resource_id") @db.VarChar(100)
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  metadata     Json     @default("{}") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model ProviderMember {
  providerId String   @map("provider_id")
  userId     String   @map("user_id")
  role       String   @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([providerId, userId])
  @@index([userId])
  @@map("provider_members")
}

model ProviderInvite {
  id         String    @id
  providerId String    @map("provider_id")
  codeHash   String    @unique @map("code_hash") @db.VarChar(64)
  role       String    @db.VarChar(20)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  usedBy     String?   @map("used_by")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  provider   Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("provider_invites")
}

/// Snapshot of what was sold, taken when the order is paid, so later catalog or commission changes never rewrite history.
model OrderItem {
  id                String   @id
  orderId           String   @map("order_id")
  providerId        String   @map("provider_id")
  productType       String   @map("product_type") @db.VarChar(20)
  busTripId         String?  @map("bus_trip_id")
  eventId           String?  @map("event_id")
  ticketCategoryId  String?  @map("ticket_category_id")
  description       String   @db.VarChar(300)
  quantity          Int
  unitPriceXof      Int      @map("unit_price_xof")
  lineTotalXof      Int      @map("line_total_xof")
  commissionBps     Int      @map("commission_bps")
  commissionXof     Int      @map("commission_xof")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          Provider @relation(fields: [providerId], references: [id])

  @@index([orderId])
  @@index([providerId, createdAt])
  @@map("order_items")
}

model CommissionRule {
  id          String    @id
  providerId  String?   @map("provider_id")
  productType String?   @map("product_type") @db.VarChar(20)
  rateBps     Int       @map("rate_bps")
  minXof      Int?      @map("min_xof")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  provider    Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([active, providerId, productType])
  @@map("commission_rules")
}

/// Append-only journal of every payment related exchange with the payment provider, kept for reconciliation and disputes.
model PaymentTransaction {
  id              String   @id
  paymentId       String   @map("payment_id")
  kind            String   @db.VarChar(30)
  providerEventId String?  @unique @map("provider_event_id") @db.VarChar(200)
  eventType       String   @map("event_type") @db.VarChar(100)
  amountXof       Int?     @map("amount_xof")
  currency        String?  @db.VarChar(3)
  status          String?  @db.VarChar(30)
  payload         Json     @default("{}") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_transactions")
}
