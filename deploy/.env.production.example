# Production settings. Copy to .env.production (never commit it) and replace every CHANGE_ME.
# The API refuses to start in production while a value looks like an example, a sandbox key or a development default.

# ---- API --------------------------------------------------------------------------------------------------------
NODE_ENV=production
APP_URL=https://CHANGE_ME.example
WEB_ORIGIN=https://CHANGE_ME.example

# Generate each secret independently:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME
TICKET_SIGNING_SECRET=CHANGE_ME
DATA_ENCRYPTION_KEY=CHANGE_ME

# Database and cache. For a managed database prefer sslmode and set PGSSL=true.
POSTGRES_USER=tickethub_4k4k_user
POSTGRES_PASSWORD=9CBf9xfDVOCejy1RYSrc0fqE33kl7CWJ
POSTGRES_DB=tickethub_4k4k
DATABASE_URL=postgresql://tickethub_4k4k_user:9CBf9xfDVOCejy1RYSrc0fqE33kl7CWJ@dpg-db18bkhsrm7s73ahug4g-a:5432/tickethub_4k4k
PGSSL=false
REDIS_URL=redis://redis:6379

# GeniusPay: live keys from the merchant dashboard, and the secret used to sign webhooks.
GENIUSPAY_API_KEY=CHANGE_ME
GENIUSPAY_API_SECRET=CHANGE_ME
GENIUSPAY_WEBHOOK_SECRET=CHANGE_ME

# Text messages (payment confirmations). Without a provider they are kept and retried.
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=

# Partner accounts must use two-factor authentication.
MFA_REQUIRED_ROLES=partner
LOG_LEVEL=info

# ---- Web build (read by docker compose when building the web image) -----------------------------------------------
# These end up printed in the legal notice and the sitemap. The build fails if a required one is empty.
VITE_SITE_URL=https://CHANGE_ME.example
VITE_LEGAL_COMPANY_NAME=
VITE_LEGAL_FORM=
VITE_LEGAL_SHARE_CAPITAL=
VITE_LEGAL_REGISTRATION_NUMBER=
VITE_LEGAL_TAX_NUMBER=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_CONTACT_PHONE=
VITE_LEGAL_PUBLICATION_DIRECTOR=
VITE_LEGAL_HOST_NAME=
VITE_LEGAL_HOST_ADDRESS=
VITE_LEGAL_HOSTING_COUNTRY=
VITE_LEGAL_DATA_PROTECTION_EMAIL=
VITE_LEGAL_ARTCI_REFERENCE=
