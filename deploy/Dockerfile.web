# Web image: builds the React app and serves it with nginx, which also proxies /api to the API container.
# Build from the repository root. The legal identity is baked into the pages at build time:
#   docker build -f deploy/Dockerfile.web -t tickethub-web \
#     --build-arg VITE_SITE_URL=https://example.ci --build-arg VITE_LEGAL_COMPANY_NAME=... (see docs/go-live.md)
FROM node:22-slim AS build
ENV PNPM_HOME=/pnpm CI=true
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/frontend/package.json apps/frontend/
COPY packages/shared/package.json packages/shared/
COPY packages/types/package.json packages/types/
RUN pnpm install --frozen-lockfile --filter @tickethub/frontend...
COPY packages packages
COPY apps/frontend apps/frontend
COPY tsconfig.json ./

ARG VITE_SITE_URL
ARG VITE_LEGAL_COMPANY_NAME
ARG VITE_LEGAL_FORM
ARG VITE_LEGAL_SHARE_CAPITAL
ARG VITE_LEGAL_REGISTRATION_NUMBER
ARG VITE_LEGAL_TAX_NUMBER
ARG VITE_LEGAL_ADDRESS
ARG VITE_LEGAL_CONTACT_EMAIL
ARG VITE_LEGAL_CONTACT_PHONE
ARG VITE_LEGAL_PUBLICATION_DIRECTOR
ARG VITE_LEGAL_HOST_NAME
ARG VITE_LEGAL_HOST_ADDRESS
ARG VITE_LEGAL_HOSTING_COUNTRY
ARG VITE_LEGAL_DATA_PROTECTION_EMAIL
ARG VITE_LEGAL_ARTCI_REFERENCE
# A release image cannot be produced with an unfinished legal notice.
ENV RELEASE_BUILD=1
RUN pnpm --filter @tickethub/frontend build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY deploy/50x.html /usr/share/nginx/html-errors/50x.html
COPY --from=build /app/apps/frontend/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s CMD wget -qO- http://127.0.0.1/healthz || exit 1
