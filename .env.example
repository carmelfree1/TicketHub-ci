# API (development defaults)
NODE_ENV=development
API_PORT=3001
APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://tickethub:tickethub@localhost:5432/tickethub
PGSSL=false
PG_POOL_SIZE=10

# Replace these development-only values with independently generated secrets.
# In production, use a secret manager and never reuse these example values.
JWT_SECRET=development-only-change-this-jwt-secret-before-deploy
TICKET_SIGNING_SECRET=development-only-change-this-ticket-secret-before-deploy
SESSION_TTL_DAYS=14
DATA_ENCRYPTION_KEY=

# Redis is optional for local development; it is required in production.
REDIS_URL=

# Partner self-registration is disabled unless an invite code is configured.
PARTNER_INVITE_CODE=

# GeniusPay credentials are server-only. Use sandbox credentials for testing.
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_API_BASE_URL=https://pay.genius.ci/api/v1/merchant

# Optional provider adapters for outbound notifications.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=

PLATFORM_COMMISSION_BPS=0
LOG_LEVEL=info
