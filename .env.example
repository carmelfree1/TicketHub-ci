# Server/API
NODE_ENV=development
API_PORT=3001
APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://tickethub:tickethub@localhost:5432/tickethub
PGSSL=false
PG_POOL_SIZE=10

# Generate independent, random secrets locally; keep them out of Git.
TICKET_SIGNING_SECRET=

# Partner self-registration is disabled unless an invite code is configured.
PARTNER_INVITE_CODE=

# GeniusPay. Keep both credentials server-side; never expose them through VITE_* variables.
# Use sandbox credentials while testing. Live keys should only be added at deployment.
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_API_BASE_URL=https://pay.genius.ci/api/v1/merchant

# Gemini is not currently used by the app.
GEMINI_API_KEY=
