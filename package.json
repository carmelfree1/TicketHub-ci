{
  "name": "tickethub-ci",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"corepack pnpm --filter @tickethub/backend dev\" \"corepack pnpm --filter @tickethub/frontend dev\"",
    "dev:api": "corepack pnpm --filter @tickethub/backend dev",
    "dev:web": "corepack pnpm --filter @tickethub/frontend dev",
    "build": "corepack pnpm --filter @tickethub/frontend build && corepack pnpm --filter @tickethub/backend build",
    "build:web": "corepack pnpm --filter @tickethub/frontend build",
    "build:api": "corepack pnpm --filter @tickethub/backend build",
    "preview": "corepack pnpm --filter @tickethub/frontend preview",
    "start": "corepack pnpm --filter @tickethub/backend start",
    "lint": "tsc --noEmit",
    "test": "corepack pnpm --filter @tickethub/backend test",
    "test:integration": "corepack pnpm --filter @tickethub/backend test:integration",
    "test:e2e": "corepack pnpm --filter @tickethub/backend test:e2e",
    "db:generate": "corepack pnpm --filter @tickethub/backend db:generate",
    "db:validate": "corepack pnpm --filter @tickethub/backend db:validate",
    "db:migrate": "corepack pnpm --filter @tickethub/backend db:migrate",
    "db:baseline:legacy": "corepack pnpm --filter @tickethub/backend db:baseline:legacy",
    "db:seed": "corepack pnpm --filter @tickethub/backend db:seed",
    "lint:eslint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.14.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
